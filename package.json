{
  "name": "project-xyz",
  "productName": "Project XYZ",
  "version": "1.0.0",
  "description": "Project XYZ – coded by Luca",
  "author": "Luca",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "@capacitor/assets": "^3.0.5"
  },
  "build": {
    "appId": "com.luca.projectxyz",
    "productName": "Project XYZ",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "ProjectXYZ-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "ProjectXYZ-Portable-${version}.exe"
    }
  }
}